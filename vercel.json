{
  "version": 2,
  "functions": {
    "server.js": {
      "includeFiles": [
        "index.html",
        "dashboard.html",
        "feedback.html",
        "feedbackform.html",
        "login.html",
        "reports.html",
        "CSS/**",
        "JS/**",
        "Image/**",
        "assets/**"
      ]
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
